# The store's own configuration, on its parent's: the engine's
# configuration call is variadic in its interface, the one call B22
# allows, in store/sqlite alone (the structure tests' tokens hold every
# other file to none); and MSVC's <filesystem> combines its stats flags, an
# enum of flags declared without their combinations, in file_size, which
# the store reads at open.
InheritParentConfig: true
Checks: >-
  -cppcoreguidelines-pro-type-vararg,
  -clang-analyzer-optin.core.EnumCastOutOfRange
