<?xml version="1.0" encoding="utf-8"?>
<RuleSet Name="qiven analysis, test code" Description="analysis.ruleset, and the rules off in the targets whose sources are all test code" ToolsVersion="17.0">
  <Include Path="analysis.ruleset" Action="Default" />
  <Rules AnalyzerId="Microsoft.Analyzers.NativeCodeAnalysis" RuleNamespace="Microsoft.Rules.Native">
    <!-- The registration pattern: a case's registrar is a global whose
         constructor adds the case to the runner's registry before main. -->
    <Rule Id="C26426" Action="None" />
  </Rules>
</RuleSet>
